LOGGING_LEVEL=INFO
OPENAI_API_KEY=replace-with-a-secret-or-key-vault-reference
OPENAI_BASE_URL=https://your-resource-name.openai.azure.com/openai/v1/
OPENAI_MODEL=replace-with-your-azure-openai-deployment-name
OPENAI_REASONING_EFFORT=high
INTERNAL_API_KEY=replace-with-a-long-random-logic-app-key
DATABASE_URL=mssql+pyodbc://user:password@localhost:1433/oliver?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no
